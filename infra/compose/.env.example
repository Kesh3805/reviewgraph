# Copy to infra/compose/.env to override defaults. Dev-only credentials.

# --- ports (all bound to 127.0.0.1) ---
RG_PG_PORT=25432
RG_REDIS_PORT=26379
RG_QDRANT_PORT=26333
RG_QDRANT_GRPC_PORT=26334
RG_OO_PORT=25080
RG_S3_PORT=29000

# --- credentials ---
RG_PG_USER=reviewgraph
RG_PG_PASSWORD=reviewgraph-dev
RG_OO_EMAIL=dev@reviewgraph.local
RG_OO_PASSWORD=Reviewgraph-Dev-0o!

# --- connection strings used by the engine and the API ---
# From the host:
DATABASE_URL=postgres://reviewgraph:reviewgraph-dev@127.0.0.1:25432/reviewgraph
REDIS_URL=redis://127.0.0.1:26379
QDRANT_URL=http://127.0.0.1:26333
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:25080/api/default
S3_ENDPOINT=http://127.0.0.1:29000
S3_BUCKET=reviewgraph-artifacts
S3_ACCESS_KEY_ID=reviewgraph-dev
S3_SECRET_ACCESS_KEY=reviewgraph-dev-secret
# From the engine build container (engine/scripts/cargo.sh), use host.docker.internal:
#   DATABASE_URL=postgres://reviewgraph:reviewgraph-dev@host.docker.internal:25432/reviewgraph

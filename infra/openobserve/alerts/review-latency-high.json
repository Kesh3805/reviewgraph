{
  "name": "rg-review-latency-high",
  "metric": "review_duration_seconds",
  "query": "p95 of review_duration_seconds",
  "threshold": {
    "operator": ">",
    "value": 120
  },
  "for": "15m",
  "frequency_minutes": 2,
  "severity": "ticket",
  "destination": "local-log",
  "labels": {
    "dashboard": "rg-review-latency"
  },
  "annotations": {
    "runbook_url": "docs/operations/runbooks/review-latency-high.md",
    "summary": "Review p95 latency above 120 s"
  }
}

      },
      {
        "name": "model",
        "label": "model"
      },
      {
        "name": "queue",
        "label": "queue"
      }
    ]
  },
  "defaultDatetimeDuration": {
    "type": "relative",
    "relativeTimePeriod": "6h"
  },
  "refreshInterval": 30

{
  "version": 5,
  "dashboardId": "rg-qdrant-latency",
  "title": "ReviewGraph: Qdrant latency",
  "description": "Source metrics: qdrant_query_duration_seconds, qdrant_queries_total",
  "role": "",
  "owner": "",
  "created": "",
  "tabs": [
    {
      "tabId": "default",
      "name": "Default",
      "panels": [
        {
          "id": "Panel_1",
          "type": "line",
          "title": "Query duration",
          "description": "",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x, sum(value) AS y FROM \"qdrant_query_duration_seconds\" GROUP BY x ORDER BY x",
              "customQuery": true,
              "fields": {
                "stream": "qdrant_query_duration_seconds",
                "stream_type": "metrics"
              },
              "config": {}
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 96,
            "h": 9,
            "i": 1
          }
        },
        {
          "id": "Panel_2",
          "type": "line",
          "title": "Queries",
          "description": "",
          "config": {
            "show_legends": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x, sum(value) AS y FROM \"qdrant_queries_total\" GROUP BY x ORDER BY x",
              "customQuery": true,
              "fields": {
                "stream": "qdrant_queries_total",
                "stream_type": "metrics"
              },
              "config": {}
            }
          ],
          "layout": {
            "x": 96,
            "y": 0,
            "w": 96,
            "h": 9,
            "i": 2
          }
        }
      ]
    }
  ],
  "variables": {
    "list": [
      {
        "name": "reviewer_type",
        "label": "reviewer_type"
      },
      {
        "name": "model",
        "label": "model"
      },
      {
        "name": "queue",
        "label": "queue"
      }
    ]
  },
  "defaultDatetimeDuration": {
    "type": "relative",
    "relativeTimePeriod": "6h"
  },
  "refreshInterval": 30
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "benchmark case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "classes",
    "language",
    "frameworks",
    "pr",
    "required_reviewers",
    "expected_findings",
    "forbidden_findings",
    "optional_findings",
    "expect_no_published_findings",
    "synthetic_fixtures"
  ],
  "$defs": {
    "category": {
      "type": "string",
      "enum": [
        "any",
        "correctness",
        "security",
        "tests",
        "architecture",
        "performance",
        "maintainability",
        "transaction",
        "concurrency",
        "api_contract",
        "error_handling",
        "data_integrity"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "window": { "type": "integer", "minimum": 0, "maximum": 200 }
      }
    },
    "expectation_id": { "type": "string", "pattern": "^[EFO][0-9]+$" }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+-[0-9]{3}-[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "correctness_regression",
          "safe_change",
          "security",
          "architecture",
          "fp_trap",
          "test_gap",
          "concurrency",
          "transaction",
          "api_contract"
        ]
      }
    },
    "language": { "type": "string", "enum": ["typescript"] },
    "frameworks": { "type": "array", "items": { "type": "string" } },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "base_branch"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "base_branch": { "type": "string" }
      }
    },
    "required_reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["correctness", "security", "tests", "architecture", "performance", "maintainability"]
      }
    },
    "expected_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categories"],
        "anyOf": [{ "required": ["symbol"] }, { "required": ["location"] }],
        "properties": {
          "id": { "$ref": "#/$defs/expectation_id" },
          "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/category" } },
          "severity_at_least": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "symbol": { "type": "string" },
          "location": { "$ref": "#/$defs/location" },
          "claim_any_of": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_ .-]+$" } },
          "must_publish": { "type": "boolean" }
        }
      }
    },
    "forbidden_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categories", "reason"],
        "anyOf": [{ "required": ["symbol"] }, { "required": ["location"] }],
        "properties": {
          "id": { "$ref": "#/$defs/expectation_id" },
          "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/category" } },
          "symbol": { "type": "string" },
          "location": { "$ref": "#/$defs/location" },
          "claim_any_of": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_ .-]+$" } },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "optional_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categories"],
        "anyOf": [{ "required": ["symbol"] }, { "required": ["location"] }],
        "properties": {
          "id": { "$ref": "#/$defs/expectation_id" },
          "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/category" } },
          "symbol": { "type": "string" },
          "location": { "$ref": "#/$defs/location" }
        }
      }
    },
    "expect_no_published_findings": { "type": "boolean" },
    "synthetic_fixtures": { "type": "boolean" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tests.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "no_findings_reason"
  ],
  "properties": {
    "no_findings_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "title",
          "claim",
          "description",
          "severity",
          "anchor",
          "affected_refs",
          "evidence",
          "claimed_relations",
          "predicate",
          "corrective_direction",
          "self_confidence",
          "test_case_ref",
          "no_mapped_test",
          "mapping_evidence_ref"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "changed_behavior_untested",
              "assertion_no_longer_covers",
              "stale_mock",
              "missing_negative_test",
              "missing_concurrency_test",
              "broken_fixture",
              "implementation_coupled_test"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "claim": {
            "type": "string",
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "side",
              "start_line",
              "end_line"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[SN][0-9]+$"
              },
              "side": {
                "type": "string",
                "enum": [
                  "head",
                  "base"
                ]
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "affected_refs": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[SNTRCD][0-9]+$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ref",
                "side",
                "start_line",
                "end_line",
                "quote",
                "explanation"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "changed_source",
                    "caller_path",
                    "callee_path",
                    "test_behavior",
                    "interface_contract",
                    "configuration",
                    "database_schema",
                    "repository_convention",
                    "deterministic_finding"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[SNTRCD][0-9]+$"
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "head",
                    "base"
                  ]
                },
                "start_line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end_line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "quote": {
                  "type": "string",
                  "maxLength": 300
                },
                "explanation": {
                  "type": "string",
                  "maxLength": 400
                }
              }
            }
          },
          "claimed_relations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "relation",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "calls",
                    "reaches_endpoint",
                    "implements",
                    "overrides",
                    "tests",
                    "reads_table",
                    "writes_table",
                    "enqueues",
                    "guarded_by",
                    "in_transaction_of",
                    "catches_errors_of"
                  ]
                }
              }
            }
          },
          "predicate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "subject",
              "params"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "call_removed",
                  "call_added",
                  "guard_removed",
                  "null_check_removed",
                  "await_missing",
                  "error_swallowed",
                  "transaction_boundary_changed",
                  "condition_changed",
                  "contract_changed",
                  "state_write_unguarded",
                  "other"
                ]
              },
              "subject": {
                "type": "string"
              },
              "params": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "corrective_direction": {
            "type": "string",
            "maxLength": 400
          },
          "self_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "test_case_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^T[0-9]+$"
          },
          "no_mapped_test": {
            "type": "boolean"
          },
          "mapping_evidence_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^D[0-9]+$"
          }
        }
      }
    }
  }
}

# Copy to apps/api/.env for local development (dev-only values; matches infra/compose).
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://reviewgraph:reviewgraph-dev@127.0.0.1:25432/reviewgraph
REDIS_URL=redis://127.0.0.1:26379
ENGINE_INTERNAL_URL=http://127.0.0.1:8081
SERVICE_JWT_SECRET=dev-only-service-jwt-secret-change-me-0123456789
SESSION_JWT_SECRET=dev-only-session-jwt-secret-change-me-0123456789
# Optional key ring for rotation: kid:base64[,kid:base64...]; first signs, all verify.
# SERVICE_JWT_KEYS=
# 32 random bytes, base64 (dev value, do not reuse).
TOKEN_CACHE_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
WEB_ORIGIN=http://localhost:3000
# CLI-only local development: set to false to skip the GitHub variables.
GITHUB_ENABLED=false
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_API_URL=https://api.github.com
# Telemetry: leave the endpoint unset (or RG_OTEL_ENABLED=false) for a no-op SDK.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:25080/api/default
# Headers are comma separated name=value pairs, values percent-encoded, e.g. Basic auth
# for OpenObserve: Authorization=Basic%20<base64(email:password)>
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=reviewgraph-api
# RG_OTEL_ENABLED=true

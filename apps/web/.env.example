# Copy to apps/web/.env.local for local development.
# Where the Next server proxies /api/* to (the NestJS control plane).
API_INTERNAL_URL=http://127.0.0.1:8080
# Optional: export server spans to OpenObserve (same names as the API).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:25080/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(email:password)>

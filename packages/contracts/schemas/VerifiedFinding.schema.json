{
  "$id": "urn:reviewgraph:contracts:VerifiedFinding",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ClaimedRelation": {
      "description": "A relation a reviewer claims between two symbols. Verification (VER-003) maps each variant onto code-graph edge kinds; `review-core` does not depend on `codegraph`, so the mapping is documented here and implemented there:\n\n| Variant | Graph edge(s) | |---|---| | `Calls` | `CALLS` (direct) | | `Reaches` | a path of `CALLS` edges | | `Tests` | `TESTS` | | `Implements` | `IMPLEMENTS` | | `Extends` | `EXTENDS` | | `Overrides` | `OVERRIDES` | | `DependsOn` | `IMPORTS` / `DEPENDS_ON` | | `ReadsConfig` | `READS_CONFIG` | | `ReadsTable` | `READS_TABLE` | | `WritesTable` | `WRITES_TABLE` | | `ProducesJob` | `PRODUCES_JOB` | | `ConsumesJob` | `CONSUMES_JOB` | | `HandlesRoute` | `HANDLED_BY` / `ROUTES_TO` | | `GuardedBy` | `GUARDED_BY` |",
      "enum": [
        "calls",
        "reaches",
        "tests",
        "implements",
        "extends",
        "overrides",
        "depends_on",
        "reads_config",
        "reads_table",
        "writes_table",
        "produces_job",
        "consumes_job",
        "handles_route",
        "guarded_by"
      ],
      "type": "string"
    },
    "Confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "DiffSide": {
      "description": "Which side of a diff a location refers to.",
      "enum": [
        "base",
        "head"
      ],
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One piece of evidence. Build the struct, then call [`Evidence::validated`]; deserialization does this automatically.",
      "properties": {
        "claim": {
          "description": "1 to 500 characters of model- or tool-authored text; treated as untrusted when rendered.",
          "type": "string"
        },
        "claimed_strength": {
          "allOf": [
            {
              "$ref": "#/definitions/EvidenceStrength"
            }
          ],
          "description": "What the producer claims. Use [`Evidence::effective_strength`] for decisions."
        },
        "kind": {
          "$ref": "#/definitions/EvidenceKind"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/definitions/EvidenceOrigin"
        },
        "relation": {
          "anyOf": [
            {
              "$ref": "#/definitions/RelationClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbols": {
          "items": {
            "$ref": "#/definitions/SymbolRef"
          },
          "type": "array"
        },
        "verification": {
          "$ref": "#/definitions/EvidenceVerification"
        }
      },
      "required": [
        "claim",
        "claimed_strength",
        "kind",
        "origin",
        "symbols",
        "verification"
      ],
      "type": "object"
    },
    "EvidenceKind": {
      "description": "The twelve PRD §52 evidence kinds.",
      "enum": [
        "changed_source",
        "caller_path",
        "callee_path",
        "test_behavior",
        "interface_contract",
        "configuration",
        "database_schema",
        "repository_convention",
        "compiler_diagnostic",
        "lint_result",
        "static_analysis_result",
        "historical_regression"
      ],
      "type": "string"
    },
    "EvidenceOrigin": {
      "description": "Who produced an evidence item.",
      "oneOf": [
        {
          "description": "Claimed by a model reviewer.",
          "properties": {
            "reviewer": {
              "$ref": "#/definitions/ReviewerType"
            },
            "type": {
              "enum": [
                "reviewer"
              ],
              "type": "string"
            }
          },
          "required": [
            "reviewer",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Produced by a deterministic tool. `tool` is a tool name only, never a command line.",
          "properties": {
            "tool": {
              "type": "string"
            },
            "type": {
              "enum": [
                "deterministic"
              ],
              "type": "string"
            }
          },
          "required": [
            "tool",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Read from the code graph.",
          "properties": {
            "type": {
              "enum": [
                "graph"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Gathered by verification stage `stage`.",
          "properties": {
            "stage": {
              "format": "uint8",
              "minimum": 0.0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "verification"
              ],
              "type": "string"
            }
          },
          "required": [
            "stage",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "EvidenceStrength": {
      "description": "Ordered ascending: `Weak < Supporting < Strong`.",
      "enum": [
        "weak",
        "supporting",
        "strong"
      ],
      "type": "string"
    },
    "EvidenceVerification": {
      "oneOf": [
        {
          "properties": {
            "status": {
              "enum": [
                "unverified"
              ],
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "stage": {
              "format": "uint8",
              "minimum": 0.0,
              "type": "integer"
            },
            "status": {
              "enum": [
                "confirmed"
              ],
              "type": "string"
            }
          },
          "required": [
            "stage",
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "type": "string"
            },
            "stage": {
              "format": "uint8",
              "minimum": 0.0,
              "type": "integer"
            },
            "status": {
              "enum": [
                "refuted"
              ],
              "type": "string"
            }
          },
          "required": [
            "reason",
            "stage",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "LineRange": {
      "additionalProperties": false,
      "description": "1-based inclusive line range. Invariant: `1 <= start <= end`.",
      "properties": {
        "end": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "A point in a source file.\n\n`line` is **1-based**. `column` is a **0-based UTF-8 byte offset** within the line, matching tree-sitter columns. Ordering is by line, then column.",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "column",
        "line"
      ],
      "type": "object"
    },
    "PublicationBand": {
      "description": "The PRD §55 publication bands. The thresholds are applied in VER-010.",
      "enum": [
        "suppress",
        "internal",
        "publish_if_medium_or_above",
        "publish"
      ],
      "type": "string"
    },
    "RelationClaim": {
      "additionalProperties": false,
      "description": "`from --relation--> to`, optionally through `via` (the claimed path, at most 8 hops).",
      "properties": {
        "from": {
          "$ref": "#/definitions/SymbolRef"
        },
        "relation": {
          "$ref": "#/definitions/ClaimedRelation"
        },
        "to": {
          "$ref": "#/definitions/SymbolRef"
        },
        "via": {
          "items": {
            "$ref": "#/definitions/SymbolRef"
          },
          "type": "array"
        }
      },
      "required": [
        "from",
        "relation",
        "to",
        "via"
      ],
      "type": "object"
    },
    "ReviewerType": {
      "description": "A reviewer specialisation. Wire form is snake_case. `Ord` gives a stable order for sorted, deduplicated collections such as a run's degraded reviewers.",
      "enum": [
        "correctness",
        "security",
        "test",
        "architecture",
        "performance",
        "maintainability"
      ],
      "type": "string"
    },
    "Severity": {
      "description": "Finding severity. `Ord` is **ascending** (`Info < Low < Medium < High < Critical`), so `sev >= Severity::Medium` reads naturally for the PRD §55 band rule. The legacy order (P0 < P1) was the reverse; ported tests must flip their comparisons.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "A place in a file at one side of a diff.",
      "properties": {
        "lines": {
          "$ref": "#/definitions/LineRange"
        },
        "path": {
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "side": {
          "$ref": "#/definitions/DiffSide"
        }
      },
      "required": [
        "lines",
        "path",
        "side"
      ],
      "type": "object"
    },
    "SourceRange": {
      "additionalProperties": false,
      "description": "A span between two [`Position`]s. Invariant: `start <= end`.",
      "properties": {
        "end": {
          "$ref": "#/definitions/Position"
        },
        "start": {
          "$ref": "#/definitions/Position"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "StageOutcome": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "type": "string"
    },
    "StageOutcomeRecord": {
      "additionalProperties": false,
      "description": "What one of the eight verification stages decided.",
      "properties": {
        "outcome": {
          "$ref": "#/definitions/StageOutcome"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "outcome",
        "stage"
      ],
      "type": "object"
    },
    "SymbolKey": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "SymbolKey",
      "type": "string"
    },
    "SymbolRef": {
      "additionalProperties": false,
      "description": "A reference to a symbol with a short human-readable label (at most 200 characters).",
      "properties": {
        "display": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/SymbolKey"
        }
      },
      "required": [
        "display",
        "id",
        "key"
      ],
      "type": "object"
    }
  },
  "description": "A candidate with a *computed* confidence (never the model's self-report), a final severity and a publication band. Maps onto `verified_findings` (DOM-009).",
  "properties": {
    "band": {
      "$ref": "#/definitions/PublicationBand"
    },
    "candidate_id": {
      "format": "uuid",
      "type": "string"
    },
    "computed_confidence": {
      "$ref": "#/definitions/Confidence"
    },
    "evidence": {
      "items": {
        "$ref": "#/definitions/Evidence"
      },
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "type": "string"
    },
    "severity": {
      "$ref": "#/definitions/Severity"
    },
    "stage_outcomes": {
      "items": {
        "$ref": "#/definitions/StageOutcomeRecord"
      },
      "type": "array"
    },
    "verification_version": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "band",
    "candidate_id",
    "computed_confidence",
    "evidence",
    "id",
    "organization_id",
    "severity",
    "stage_outcomes",
    "verification_version"
  ],
  "title": "VerifiedFinding",
  "type": "object"
}

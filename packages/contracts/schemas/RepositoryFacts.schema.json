{
  "$id": "urn:reviewgraph:contracts:RepositoryFacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AdrFact": {
      "properties": {
        "number": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "AuthFacts": {
      "description": "Auth libraries discovered at init. Route-level boundaries come from NEST-004 at index time.",
      "properties": {
        "libraries": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "libraries"
      ],
      "type": "object"
    },
    "BuildSystemFact": {
      "properties": {
        "config": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/BuildSystemKind"
        },
        "scope_dir": {
          "type": "string"
        }
      },
      "required": [
        "config",
        "kind",
        "scope_dir"
      ],
      "type": "object"
    },
    "BuildSystemKind": {
      "enum": [
        "nest_cli",
        "tsc",
        "webpack",
        "vite",
        "rollup",
        "esbuild",
        "tsup",
        "swc",
        "turbo",
        "nx",
        "make",
        "bazel",
        "maven",
        "gradle",
        "cargo",
        "go_build",
        "just",
        "taskfile"
      ],
      "type": "string"
    },
    "CiFact": {
      "properties": {
        "path": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/definitions/CiProvider"
        },
        "workflow": {
          "anyOf": [
            {
              "$ref": "#/definitions/CiWorkflow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "provider"
      ],
      "type": "object"
    },
    "CiProvider": {
      "enum": [
        "github_actions",
        "gitlab",
        "circle_ci",
        "jenkins",
        "azure_pipelines",
        "bitbucket",
        "buildkite",
        "cloud_build"
      ],
      "type": "string"
    },
    "CiWorkflow": {
      "properties": {
        "actions": {
          "description": "`uses:` action references such as `actions/checkout@v4`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "jobs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_tools": {
          "description": "First tokens of `run:` commands only (`npm`, `docker`, ...).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "triggers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "actions",
        "jobs",
        "run_tools",
        "triggers"
      ],
      "type": "object"
    },
    "CodeownersFact": {
      "properties": {
        "invalid_lines": {
          "description": "1-based line numbers that are neither comments nor `pattern owner+` lines.",
          "items": {
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/definitions/CodeownersRule"
          },
          "type": "array"
        }
      },
      "required": [
        "invalid_lines",
        "path",
        "rules"
      ],
      "type": "object"
    },
    "CodeownersRule": {
      "properties": {
        "owners": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pattern": {
          "type": "string"
        }
      },
      "required": [
        "owners",
        "pattern"
      ],
      "type": "object"
    },
    "CommitSha": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "CommitSha",
      "type": "string"
    },
    "DefaultBranchSource": {
      "enum": [
        "origin_head",
        "provider",
        "well_known_name",
        "current_branch",
        "unknown"
      ],
      "type": "string"
    },
    "DeferredToIndex": {
      "description": "API routes need parsing, so they are produced at index time (NEST-002 / IDX).",
      "properties": {
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "DepKind": {
      "enum": [
        "prod",
        "dev",
        "peer",
        "optional"
      ],
      "type": "string"
    },
    "DepSpec": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/DepKind"
        },
        "range": {
          "type": "string"
        },
        "workspace_protocol": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "range",
        "workspace_protocol"
      ],
      "type": "object"
    },
    "DirtyState": {
      "properties": {
        "is_dirty": {
          "type": "boolean"
        },
        "sample_paths": {
          "description": "At most 20 paths, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "staged": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "truncated": {
          "description": "The scan stopped at the entry limit; the counts are lower bounds.",
          "type": "boolean"
        },
        "unstaged": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "untracked": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "is_dirty",
        "sample_paths",
        "staged",
        "truncated",
        "unstaged",
        "untracked"
      ],
      "type": "object"
    },
    "DocsFacts": {
      "properties": {
        "adrs": {
          "items": {
            "$ref": "#/definitions/AdrFact"
          },
          "type": "array"
        },
        "agent_instructions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "architecture": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "codeowners": {
          "anyOf": [
            {
              "$ref": "#/definitions/CodeownersFact"
            },
            {
              "type": "null"
            }
          ]
        },
        "contributing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "knowledge_vaults": {
          "items": {
            "$ref": "#/definitions/KnowledgeVault"
          },
          "type": "array"
        },
        "pr_templates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule_docs": {
          "items": {
            "$ref": "#/definitions/RuleDocCandidate"
          },
          "type": "array"
        },
        "security_policy": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "adrs",
        "agent_instructions",
        "architecture",
        "contributing",
        "knowledge_vaults",
        "pr_templates",
        "rule_docs",
        "security_policy"
      ],
      "type": "object"
    },
    "Ecosystem": {
      "enum": [
        "npm",
        "pypi",
        "go",
        "cargo",
        "maven",
        "gradle",
        "rubygems",
        "composer",
        "nuget"
      ],
      "type": "string"
    },
    "EntrypointFact": {
      "oneOf": [
        {
          "properties": {
            "source": {
              "enum": [
                "package_main"
              ],
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "source": {
              "enum": [
                "package_bin"
              ],
              "type": "string"
            }
          },
          "required": [
            "name",
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "source": {
              "enum": [
                "script"
              ],
              "type": "string"
            }
          },
          "required": [
            "name",
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "enum": [
                "nest_cli"
              ],
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "call": {
              "type": "string"
            },
            "source": {
              "enum": [
                "bootstrap"
              ],
              "type": "string"
            }
          },
          "required": [
            "call",
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "enum": [
                "conventional"
              ],
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "enum": [
                "dockerfile"
              ],
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "enum": [
                "procfile"
              ],
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "source": {
              "enum": [
                "serverless"
              ],
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "confidence": {
          "format": "float",
          "type": "number"
        },
        "kind": {
          "$ref": "#/definitions/EntrypointKind"
        },
        "package": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "kind",
        "path"
      ],
      "type": "object"
    },
    "EntrypointKind": {
      "enum": [
        "http_server",
        "worker",
        "microservice",
        "cli",
        "script",
        "library",
        "serverless"
      ],
      "type": "string"
    },
    "EnvFileFact": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/EnvFileKind"
        },
        "path": {
          "type": "string"
        },
        "tracked_in_git": {
          "type": "boolean"
        },
        "variable_names": {
          "description": "Template files only; always empty for `Real`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "path",
        "tracked_in_git",
        "variable_names"
      ],
      "type": "object"
    },
    "EnvFileKind": {
      "enum": [
        "template",
        "real"
      ],
      "type": "string"
    },
    "EvidenceSource": {
      "oneOf": [
        {
          "properties": {
            "dep_kind": {
              "$ref": "#/definitions/DepKind"
            },
            "kind": {
              "enum": [
                "dependency"
              ],
              "type": "string"
            }
          },
          "required": [
            "dep_kind",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "config_file"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "schema_file"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "FrameworkCategory": {
      "enum": [
        "web",
        "ui",
        "orm",
        "queue",
        "test",
        "auth",
        "validation",
        "config",
        "docs"
      ],
      "type": "string"
    },
    "FrameworkEvidence": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/EvidenceSource"
        }
      },
      "required": [
        "detail",
        "path",
        "source"
      ],
      "type": "object"
    },
    "FrameworkFact": {
      "properties": {
        "category": {
          "$ref": "#/definitions/FrameworkCategory"
        },
        "confidence": {
          "format": "float",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/definitions/FrameworkEvidence"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "major": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scope": {
          "description": "Package directory (the repository root is the empty string).",
          "type": "string"
        },
        "version_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "via": {
          "description": "The host framework when only a wrapper package was found.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "confidence",
        "evidence",
        "id",
        "scope"
      ],
      "type": "object"
    },
    "GeneratedKind": {
      "enum": [
        "generated",
        "vendored",
        "lockfile",
        "minified"
      ],
      "type": "string"
    },
    "GeneratedSummary": {
      "description": "Generated-code summary. The per-file map is kept out of `repository.json`.",
      "properties": {
        "by_kind": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "object"
        },
        "by_reason": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "object"
        },
        "config_globs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dirs": {
          "items": {
            "items": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/GeneratedKind"
              },
              {
                "format": "uint64",
                "minimum": 0.0,
                "type": "integer"
              }
            ],
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "type": "array"
        },
        "files": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "by_kind",
        "by_reason",
        "config_globs",
        "dirs",
        "files"
      ],
      "type": "object"
    },
    "GitState": {
      "properties": {
        "default_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_branch_source": {
          "$ref": "#/definitions/DefaultBranchSource"
        },
        "dirty": {
          "$ref": "#/definitions/DirtyState"
        },
        "head": {
          "$ref": "#/definitions/HeadState"
        },
        "is_linked_worktree": {
          "type": "boolean"
        },
        "is_shallow": {
          "type": "boolean"
        },
        "lfs_patterns": {
          "description": "`.gitattributes` patterns that carry `filter=lfs`, in file order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remotes": {
          "description": "Sorted by name.",
          "items": {
            "$ref": "#/definitions/RemoteFact"
          },
          "type": "array"
        },
        "submodules": {
          "description": "Paths from `.gitmodules`, sorted. Never recursed into.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "default_branch_source",
        "dirty",
        "head",
        "is_linked_worktree",
        "is_shallow",
        "lfs_patterns",
        "remotes",
        "submodules"
      ],
      "type": "object"
    },
    "HeadState": {
      "oneOf": [
        {
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "commit"
              ],
              "type": "string"
            },
            "sha": {
              "$ref": "#/definitions/CommitSha"
            }
          },
          "required": [
            "kind",
            "sha"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "detached"
              ],
              "type": "string"
            },
            "sha": {
              "$ref": "#/definitions/CommitSha"
            }
          },
          "required": [
            "kind",
            "sha"
          ],
          "type": "object"
        },
        {
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "unborn"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "InfraFact": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/InfraKind"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "InfraKind": {
      "enum": [
        "dockerfile",
        "compose",
        "terraform",
        "helm",
        "kubernetes",
        "serverless",
        "cloud_build",
        "app_engine",
        "fly",
        "vercel",
        "netlify",
        "docker_ignore"
      ],
      "type": "string"
    },
    "InitWarning": {
      "description": "A non-fatal observation made while initializing a repository.",
      "properties": {
        "code": {
          "description": "Stable snake_case code, for example `non_utf8_path` or `symlink_escapes_root`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "allOf": [
            {
              "$ref": "#/definitions/WarningSeverity"
            }
          ],
          "default": "warning"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "InventorySummary": {
      "description": "Totals over the walked inventory (not the per-file list).",
      "properties": {
        "by_class": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "object"
        },
        "ignored": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "object"
        },
        "total_dirs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "total_files": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "by_class",
        "ignored",
        "total_dirs",
        "total_files"
      ],
      "type": "object"
    },
    "KnowledgeVault": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/VaultKind"
        },
        "markdown_files": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "markdown_files",
        "root"
      ],
      "type": "object"
    },
    "Language": {
      "description": "A language or file format. Wire form is the lowercase name. New variants are additive.",
      "enum": [
        "typescript",
        "javascript",
        "python",
        "java",
        "go",
        "rust",
        "kotlin",
        "csharp",
        "ruby",
        "php",
        "shell",
        "sql",
        "yaml",
        "json",
        "toml",
        "markdown",
        "html",
        "css",
        "dockerfile",
        "terraform",
        "protobuf",
        "graphql",
        "prisma",
        "other"
      ],
      "type": "string"
    },
    "LanguageStat": {
      "properties": {
        "analyzable": {
          "description": "A registered analyzer exists for this language.",
          "type": "boolean"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "files": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "generated_files": {
          "description": "Filled by INIT-008 once generated code is classified.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "language": {
          "$ref": "#/definitions/Language"
        },
        "lines": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "analyzable",
        "bytes",
        "files",
        "generated_files",
        "language",
        "lines"
      ],
      "type": "object"
    },
    "LayoutFacts": {
      "properties": {
        "source_roots": {
          "items": {
            "$ref": "#/definitions/RootFact"
          },
          "type": "array"
        },
        "test_globs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "test_regexes": {
          "description": "`testRegex` values from Jest configuration, verbatim.",
          "items": {

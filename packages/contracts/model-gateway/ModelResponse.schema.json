{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AttemptedCandidate": {
      "description": "A fallback that was attempted and why it did not serve the call.",
      "properties": {
        "error_class": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "error_class",
        "model",
        "provider"
      ],
      "type": "object"
    },
    "FinishReason": {
      "oneOf": [
        {
          "enum": [
            "complete",
            "max_tokens",
            "refusal",
            "content_filter"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "required": [
            "other"
          ],
          "type": "object"
        }
      ]
    },
    "ModelOutput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "json": true
          },
          "required": [
            "json"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "ModelTier": {
      "description": "Capability tier a caller asks for. Callers never name a model (ADR-010).",
      "enum": [
        "classifier",
        "fast_reasoner",
        "review_reasoner",
        "verifier",
        "deep_reasoner"
      ],
      "type": "string"
    },
    "RouteCandidate": {
      "description": "One routable (provider, model) pair.",
      "properties": {
        "max_context": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "supports_reasoning": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "max_context",
        "model",
        "provider"
      ],
      "type": "object"
    },
    "RouteDecision": {
      "description": "How a call was routed. Persisted by consumers (`reviewer_runs.route`).",
      "properties": {
        "attempted": {
          "default": [],
          "items": {
            "$ref": "#/definitions/AttemptedCandidate"
          },
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/definitions/RouteCandidate"
          },
          "type": "array"
        },
        "downgraded": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_tier": {
          "$ref": "#/definitions/ModelTier"
        },
        "requested_tier": {
          "$ref": "#/definitions/ModelTier"
        },
        "table_hash": {
          "type": "string"
        }
      },
      "required": [
        "candidates",
        "effective_tier",
        "requested_tier",
        "table_hash"
      ],
      "type": "object"
    },
    "ServedFrom": {
      "enum": [
        "live",
        "response_cache",
        "replay"
      ],
      "type": "string"
    },
    "Usage": {
      "description": "Token usage with provider semantics normalised: `input_uncached` excludes cache reads and writes, and `output` includes reasoning tokens.",
      "properties": {
        "cache_read": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "cache_write": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "input_uncached": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "output": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "reasoning": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cache_read",
        "cache_write",
        "input_uncached",
        "output",
        "reasoning"
      ],
      "type": "object"
    }
  },
  "properties": {
    "attempts": {
      "format": "uint8",
      "minimum": 0.0,
      "type": "integer"
    },
    "cost_usd_micros": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "finish_reason": {
      "$ref": "#/definitions/FinishReason"
    },
    "latency_ms": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "model": {
      "type": "string"
    },
    "output": {
      "$ref": "#/definitions/ModelOutput"
    },
    "provider": {
      "type": "string"
    },
    "request_hash": {
      "type": "string"
    },
    "route": {
      "$ref": "#/definitions/RouteDecision"
    },
    "served_from": {
      "$ref": "#/definitions/ServedFrom"
    },
    "usage": {
      "$ref": "#/definitions/Usage"
    },
    "usage_original": {
      "anyOf": [
        {
          "$ref": "#/definitions/Usage"
        },
        {
          "type": "null"
        }
      ],
      "description": "On a response-cache hit: the usage of the call that produced the cached output (`usage` is zero because nothing was billed)."
    }
  },
  "required": [
    "attempts",
    "finish_reason",
    "latency_ms",
    "model",
    "output",
    "provider",
    "request_hash",
    "route",
    "served_from",
    "usage"
  ],
  "title": "ModelResponse",
  "type": "object"
}
